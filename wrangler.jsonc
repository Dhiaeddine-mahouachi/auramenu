{
  "name": "auramenu-staging",
  "main": "edge/worker.mjs",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [],
  "assets": {
    "directory": ".wrangler/staging-assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "build": { "command": "node edge/stage-assets.mjs" },
  "services": [{ "binding": "AURADIGITAL", "service": "auradigital-staging" }],
  "vars": {
    "STAGING": "true",
    "PRETTY_MENU_ROUTES": "true",
    "CANONICAL_ORIGIN": "https://auramenu.space",
    "ACCOUNTS_ORIGIN": "https://auradigital-staging.dhiamahouachi2025.workers.dev"
  }
}
